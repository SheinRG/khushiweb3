{
  "name": "minichain",
  "version": "1.0.0",
  "description": "A beginner-friendly blockchain built from scratch with zero dependencies, to learn how Web3 works under the hood.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js --port 3001",
    "test": "node --test",
    "demo": "node src/demo.js",
    "reset": "node -e \"require('node:fs').rmSync('data',{recursive:true,force:true})\""
  },
  "license": "MIT"
}
